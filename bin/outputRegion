#!/bin/bash
# Outputs Makefile targets for single tiles within a region defined by lat/lon bounds.

# saner programming env: these switches turn some bugs into errors
set -o errexit -o pipefail -o noclobber -o nounset

minLat="$1"
maxLat="$2"
minLon="$3"
maxLon="$4"

tiles=""
for lat in $(seq "$minLat" "$maxLat"); do
	for lon in $(seq "$minLon" "$maxLon"); do
		tiles="$tiles z_ao_.single_$(printf "%+03d%+04d" "$lat" "$lon")_zl${ZL}_${VARIANT}_v${VERSION}"
	done
done

echo "$tiles"
