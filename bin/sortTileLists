#!/bin/bash
# Sorts *_tile_list files ascending by latitude then longitude
# @arg path to a single *_tile_list file to sort in place

# saner programming env: these switches turn some bugs into errors
set -o errexit -o pipefail -o noclobber -o nounset

# Sorts a single file in place. Only the first 7 characters of each line
# (sign+2-digit lat, sign+3-digit lon) are used as the sort key, so this
# works whether lines carry a .dsf suffix or not.
#
# Note: GNU sort's -k1.1,1.3n -k1.4,1.7n character-offset key syntax turns
# out to silently misbehave (no reordering at all) once two such keys are
# combined on these lines, so the lat/lon numbers are extracted with awk
# and prefixed as explicit sort fields instead.
sortFile() {
	local file="$1"
	local tmp
	tmp="$(mktemp "$(dirname "$file")/.sortTileLists.XXXXXX")"
	awk '{ print (substr($0,1,3)+0), (substr($0,4,4)+0), $0 }' "$file" \
		| LC_ALL=C sort -s -k1,1n -k2,2n \
		| cut -d' ' -f3- \
		>| "$tmp"
	mv "$tmp" "$file"
}

tileListFile="$1"

sortFile "$tileListFile"
echo "sorted $tileListFile"
