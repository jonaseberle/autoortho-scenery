#!/usr/bin/env bash
# Update raster layers in _z_ao_packages-world-tiles.xcf from all *_tile_list files.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/.venv-updateTilesImage"
REQS="$SCRIPT_DIR/updateTilesImage_requirements.txt"
PY="$SCRIPT_DIR/updateTilesImage.py"

# Create venv if it doesn't exist yet
if [ ! -d "$VENV" ]; then
    echo "Creating virtual environment…"
    python3 -m venv "$VENV"
fi

# Install / sync dependencies
"$VENV/bin/pip" install --quiet -r "$REQS"

exec "$VENV/bin/python3" "$PY" "$@"
